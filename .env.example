# Copy to .env.local for local work. Add production values in Vercel.
# Never commit real values. Variables are grouped by the phase that first needs them.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
MAX_NOTE_CHARS=100000

# --- Supabase (Phase 1) ---
# Locally: the dev and test project. On Vercel: the production project.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe in the browser, RLS applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Bypasses RLS. Server only, never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Supabase for RLS tests (Phase 1) ---
# The dev and test project, never production. Tests create and delete their own users.
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SECRET_KEY=

# --- Anthropic (Phase 3) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_MONTHLY_CAP_USD=5

# --- Google Calendar and Tasks (Phase 5) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# On Vercel, use your deployed URL.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# 32 random bytes, base64. Encrypts Google tokens at rest.
TOKEN_ENC_KEY=

# --- Email reminders (Phase 6) ---
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
# Emails are only logged unless this is true.
RESEND_ENABLED=false
# Random string. Signs one-click unsubscribe links.
UNSUBSCRIBE_SECRET=
# Random string. Vercel Cron sends it as a bearer token.
CRON_SECRET=

# --- Sentry (Phase 8) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
