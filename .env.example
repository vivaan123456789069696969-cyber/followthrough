# Copy to .env.local for local work. Add production values in Vercel.
# Never commit real values. Variables are grouped by the phase that first needs them.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
MAX_NOTE_CHARS=100000

# --- Supabase (Phase 1) ---
# Locally: the dev and test project. On Vercel: the production project.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe in the browser, RLS applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Bypasses RLS. Server only, never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Supabase for RLS tests (Phase 1) ---
# The dev and test project, never production. Tests create and delete their own users.
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SECRET_KEY=
# The dev project's ref. Live tests refuse to run on any other project.
TEST_SUPABASE_DEV_PROJECT_REF=

# Set to true only after the Google provider is set up in Supabase. Until then the button is hidden.
NEXT_PUBLIC_GOOGLE_SIGN_IN=false

# --- Anthropic (Phase 3) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_MONTHLY_CAP_USD=5
# How hard Claude thinks: low, medium, high, xhigh or max. Medium suits extraction.
ANTHROPIC_EFFORT=medium
# Suggestion runs allowed per user per hour.
AI_HOURLY_LIMIT=10
# Optional: spending limit for all users together, per month, in US dollars. Empty means none.
AI_GLOBAL_MONTHLY_CAP_USD=

# --- Google Calendar and Tasks (Phase 5) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# On Vercel, use your deployed URL.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# 32 random bytes, base64. Encrypts Google tokens at rest. Changing it disconnects everyone.
TOKEN_ENC_KEY=
# Google also needs SUPABASE_SECRET_KEY (above) and CRON_SECRET (below) for syncing.
# Test only: point Google's addresses at a stand-in server. Ignored unless GOOGLE_TEST_ENDPOINTS=true.
# GOOGLE_TEST_ENDPOINTS=
# GOOGLE_AUTH_URL=
# GOOGLE_TOKEN_URL=
# GOOGLE_REVOKE_URL=
# GOOGLE_API_URL=

# --- Email reminders (Phase 6) ---
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
# Emails are only logged unless this is true.
RESEND_ENABLED=false
# Random string, at least 32 characters. Signs one-click unsubscribe links. No reminders are sent without it.
UNSUBSCRIBE_SECRET=
# Test only: a stand-in for Resend, and ?now= on the reminder job. Ignored unless set to true.
# RESEND_TEST_ENDPOINTS=
# RESEND_API_URL=
# REMINDERS_TEST_CLOCK=
# Random string, at least 32 characters. The scheduled jobs send it as a bearer token to /api/cron/*:
# Supabase's pg_cron every 15 minutes (reminders and Google retries; also stored in Supabase Vault as
# cron_secret) and Vercel Cron once a day (Google retries). Use the same value in all three places.
CRON_SECRET=

# --- Sentry (Phase 8) ---
# Error reporting is off until these are set (use the same DSN for both). Only scrubbed errors are
# sent: no notes, task text, names, emails or request data. Source maps aren't uploaded.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
