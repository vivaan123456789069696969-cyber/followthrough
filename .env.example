# Copy to .env.local for local work. Add the same values in Vercel for deploys.
# Never commit real values. Variables are grouped by the phase that first needs them.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
MAX_NOTE_CHARS=100000

# --- Supabase, app project (Phase 1). Use the dev project locally, production on Vercel. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- Supabase, test project for RLS tests (Phase 1). Its data is wiped by tests. ---
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
TEST_SUPABASE_DB_URL=

# --- Anthropic (Phase 3) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_MONTHLY_CAP_USD=5

# --- Google Calendar and Tasks (Phase 5) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# 32 random bytes, base64. Encrypts Google tokens at rest.
TOKEN_ENC_KEY=

# --- Email reminders (Phase 6) ---
RESEND_API_KEY=
# Pending decision: the address on your verified domain.
RESEND_FROM=
RESEND_REPLY_TO=
# Emails are only logged unless this is true.
RESEND_ENABLED=false
# Random string. Signs one-click unsubscribe links.
UNSUBSCRIBE_SECRET=
# Random string. Vercel Cron sends it as a bearer token.
CRON_SECRET=

# --- Sentry (Phase 8) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
